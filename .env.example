# NeuroShield Environment Variables
# Copy this file to backend/.env and fill in the values

# ─── Required ────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Get from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret (generate a random string, keep it secret)
JWT_SECRET=your-super-secret-jwt-key-change-this

# ─── Optional ─────────────────────────────────────────────────────────────────
# Gemini AI API key (for AI insights feature)
GEMINI_API_KEY=your-gemini-api-key-here

# Server port (default: 5000)
PORT=5000

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app.vercel.app

# JWT expiry
JWT_EXPIRES_IN=24h
