# NeuroShield Backend Environment Configuration Template
# Copy this file to a new file named '.env' in the same directory and fill in your values.

# Port for the backend Express/WebSocket server
PORT=5000

# Environment mode (development/production)
NODE_ENV=development

# Path to the SQLite database file
DB_PATH=./data/neuroshield.db

# Secret key for signing JWT tokens (use a long random string in production)
JWT_SECRET=neuroshield_super_secret_jwt_key_change_me_in_production

# Allowed origins for CORS (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:5001

# Google Gemini API Key for AI Security Insights (Optional)
# If provided, enables automated threat explanation and mitigation advice.
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
