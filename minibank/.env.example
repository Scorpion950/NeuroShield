# MiniBank (Simulation) Environment Configuration Template
# Copy this file to a new file named '.env' in the same directory to customize.
# Default values will be used if this file is omitted.

# Port for the simulated bank web app
MINIBANK_PORT=5001

# URL of the NeuroShield threat monitoring backend (for log forwarding)
NEUROSHIELD_URL=http://localhost:5000

# Secret internal API key matching backend credentials
MINIBANK_API_KEY=mb-api-key-neuroshield-internal-2024

# Enable debug logging for the log forwarder (true/false)
LOG_FORWARDER_DEBUG=false
